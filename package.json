{
  "name": "fancheng-finance",
  "productName": "姊垫緞閲戣瀺",
  "version": "1.13.5",
  "description": "鍏ㄧ悆鎸囨暟銆佸ぇ瀹楀晢鍝併€佺編鑱斿偍銆佹棩鏈ぎ琛屻€佺編鍥借储鏀块儴銆佹柊鍗庣ぞ瀹炴椂淇℃伅鑱氬悎妗岄潰搴旂敤",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir",
    "postinstall": "node scripts/download-electron.js"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fancheng.finance",
    "productName": "姊垫緞閲戣瀺",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "electron/**/*",
      "services/**/*",
      "src/**/*",
      "scripts/download-electron.js",
      "scripts/create-shortcuts.js",
      "scripts/sync-dist-out.js",
      "package.json",
      "index.html",
      "app.js",
      "styles.css",
      "assets/**/*",
      "*.bat",
      "update-shortcuts.ps1",
      "node_modules/**/*",
      "!node_modules/@types/**",
      "!node_modules/typescript/**",
      "!**/_*.js",
      "!dist/**",
      "!dist-*/**",
      "!dist-build/**",
      "!dist-out/**",
      "!dist-new/**",
      "!_asar-*/**",
      "!_pkg-extract/**"
    ],
    "win": {
      "target": "dir",
      "executableName": "FanchengFinance",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
