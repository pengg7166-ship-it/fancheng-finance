# 复制为 .env 并 E:\FanchengFinance\userData\.env 填入你的 FRED API Key
# 申请地址：https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 可选：数据盘盘符（NVMe 推荐，减轻系统盘 I/O 与启动卡顿）
# 数据目录：{盘符}:\FanchengFinance\data  例：E:\FanchengFinance\data
# 开发/打包均可设；也可在系统环境变量或 启动梵澄金融-安全.bat 中设置
FANCHENG_DATA_DRIVE=E
310f083681f6842ba67d84c5372c660b
# 欧洲等地指数 K 线（Stooq 免费密钥）
# 申请地址：https://stooq.pl/q/d/?s=^dax&get_apikey
STOOQ_API_KEY=

# 可选：Cursor 大宗走势研判（User API Key · https://cursor.com/dashboard/integrations）
CURSOR_API_KEY=
FANCHENG_CURSOR_MODEL=composer-2.5
FANCHENG_CURSOR_API_URL=http://127.0.0.1:8765/v1
FANCHENG_CURSOR_TIMEOUT_MS=120000

# 可选：LLM 增强问答（OpenAI 兼容 API）
# 开发：复制为项目根目录 .env
# 打包版请复制到 E:\FanchengFinance\userData\.env
FANCHENG_LLM_API_URL=https://api.openai.com/v1/chat/completions
FANCHENG_LLM_API_KEY=
FANCHENG_LLM_MODEL=gpt-4o-mini
FANCHENG_LLM_TIMEOUT_MS=30000
